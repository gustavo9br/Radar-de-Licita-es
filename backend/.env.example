# Porta em que o backend sobe
PORT=3001

# Origem permitida pro CORS (frontend em dev: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Airtable — Personal Access Token com escopo data.records:read/write na base usada
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Analises

# Token simples pra proteger o disparo do pipeline (header X-App-Token)
APP_TOKEN=troque-por-um-valor-secreto
